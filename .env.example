# Copy to .env.local for local development, and set the same variables in the
# hosting project's environment for a deployment.
#
# NO VITE_ PREFIX, DELIBERATELY: Vite only exposes VITE_-prefixed variables to
# the browser, so this key is readable by the dev server and the serverless
# function and can never be bundled into client code.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional. Omit to use the application default.
ASSISTANT_MODEL=claude-haiku-4-5
